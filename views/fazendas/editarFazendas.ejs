<%- include('../parts/header') %>



<div class="main-wrapper">
   

    <main class="content">

        <%# Mensagens flash %>
        <% if (req_message && req_message.length > 0) { %>
            <div class="alert alert-<%= req_status %>">
                <%= req_message %>
            </div>
        <% } %>

        <div class="table-header">
            <h2>Editando: <%= fazenda.fazenda %></h2>
            <a href="/fazendas/listaFazendas" class="btn-novo">← Voltar</a>
        </div>

        <div class="card-form">
            <form action="/fazendas/atualizar/<%= fazenda.id %>" method="POST">
                <div class="form-grid">

                    <div class="form-group full-width">
                        <label>Nome da Fazenda *</label>
                        <input type="text"
                               name="fazenda"
                               value="<%= fazenda.fazenda %>"
                               required>
                    </div>

                    <div class="form-group full-width">
                        <button type="submit" class="btn-salvar">
                            💾 Salvar Alterações
                        </button>
                    </div>

                </div>
            </form>
        </div>

    </main>
</div>

<%- include('../parts/footer') %>
