<%- include('../parts/header') %>

<div id="overlay"></div>

<div class="main-wrapper">

    <main class="content">

        <%# Mensagens flash %>
        <% if (req_message && req_message.length > 0) { %>
            <div class="alert alert-<%= req_status %>">
                <%= req_message %>
            </div>
        <% } %>

        <div class="table-header">
            <h2>Editando: SISBOV <%= animal.sisbov %></h2>
            <a href="/animais/listaAnimais" class="btn-novo">← Voltar</a>
        </div>

        <div class="card-form">
            <form action="/animais/atualizar/<%= animal.id %>" method="POST">
                <div class="form-grid">

                    <div class="form-group">
                        <label>SISBOV *</label>
                        <input type="text" name="sisbov" 
                               value="<%= animal.sisbov %>" required>
                    </div>

                    <div class="form-group">
                        <label>Raça *</label>
                        <input type="text" name="raca" 
                               value="<%= animal.raca %>" required>
                    </div>

                    <div class="form-group">
                        <label>Faixa Etária</label>
                        <select name="faixa_etaria">
                            <option value="">Selecione...</option>
                            <% ['Bezerro','Garrote','Novilho','Adulto'].forEach(fx => { %>
                                <option value="<%= fx %>" 
                                    <%= animal.faixa_etaria === fx ? 'selected' : '' %>>
                                    <%= fx %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Fazenda *</label>
                        <select name="id_fazenda" required>
                            <% fazendas.forEach(f => { %>
                                <option value="<%= f.id %>"
                                    <%= animal.id_fazenda === f.id ? 'selected' : '' %>>
                                    <%= f.fazenda %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Peso Atual (kg)</label>
                        <input type="number" name="peso_atual" 
                               step="0.01"
                               value="<%= animal.peso_atual ?? '' %>">
                    </div>

                    <div class="form-group">
                        <label>Data de Entrega *</label>
                        <input type="date" name="dataEntrega"
                               value="<%= new Date(animal.dataEntrega).toISOString().split('T')[0] %>"
                               required>
                    </div>

                    <div class="form-group">
                        <label>Hora de Entrega</label>
                        <input type="time" name="horaEntrega"
                               value="<%= animal.horaEntrega ?? '' %>">
                    </div>

                    <div class="form-group full-width">
                        <button type="submit" class="btn-salvar">
                            💾 Salvar Alterações
                        </button>
                    </div>

                </div>
            </form>
        </div>

    </main>
</div>

<%- include('../parts/footer') %>